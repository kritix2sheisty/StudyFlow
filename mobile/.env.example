# Where the StudyFlow API is. Copy this file to .env.
# Hosted (phones work off campus): https://<your-api-host>  — no trailing slash
# Laptop on the same Wi-Fi: http://<LAN IP>:8010  (Windows: ipconfig -> IPv4 Address)
# After editing .env restart with: npx expo start -c
EXPO_PUBLIC_API_URL=https://your-api-host.up.railway.app
